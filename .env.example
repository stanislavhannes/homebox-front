# Kopieren nach .env.local und ausfüllen. .env.local wird nicht eingecheckt.

# Homebox-Instanz und API-Key (Homebox → Profil → API-Keys, beginnt mit hb_)
HOMEBOX_URL=https://homebox.example.org
HOMEBOX_TOKEN=

# 1 = Beispieldaten statt Homebox (zum Ausprobieren ohne Token, schreibt nichts)
HOMEBOX_MOCK=0

# Passwort für /admin
ADMIN_PASSWORD=

# Zufälliger Schlüssel für Cookies, mind. 32 Zeichen: openssl rand -base64 48
SESSION_SECRET=

# Wo die App ihre Pages/Einstellungen speichert (SQLite)
DATABASE_PATH=data/app.db
